<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.garrett_webb.terminalpolyominos</id>
  <name>terminalpolyominos</name>
  <summary>Colored polyomino stacking game for Unix terminals</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer_name>Garrett Webb</developer_name>
  <description>
    <p>
      Lightweight colored polyomino stacking game for the terminal. Classic SRS
      rotation, hold, ghost piece, lock delay, local high scores, and
      configurable keys and timing.
    </p>
    <p>
      Launch from the app menu to play in a built-in terminal window, or run
      <code>terminalpolyominos</code> in your preferred terminal emulator
      (tmux, zellij, Kitty, etc.).
    </p>
    <p>
      Not affiliated with or endorsed by The Tetris Company.
    </p>
  </description>
  <launchable type="desktop-id">io.github.garrett_webb.terminalpolyominos.desktop</launchable>
  <launchable type="desktop-id">io.github.garrett_webb.terminalpolyominos-terminal.desktop</launchable>
